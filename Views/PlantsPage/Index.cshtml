<h1>🌱 Zarządzanie Bazą Roślin</h1>

<div id="successMessage" style="display: none; background: #d4edda; color: #155724; padding: 12px; border-radius: 4px; margin-bottom: 20px; border: 1px solid #c3e6cb; font-weight: bold;">
    ✅ Roślina została pomyślnie dodana.
</div>

<div style="background: #f9f9f9; padding: 20px; border-radius: 8px; margin-bottom: 30px; border: 1px solid #ddd; max-width: 500px;">
    <h3 style="color: #2e7d32; margin-top: 0;">➕ Dodaj roślinę do bazy</h3>

    <div style="margin-bottom: 10px;">
        <label><b>Nazwa:</b></label><br>
        <input type="text" id="plantName" style="width: 100%; padding: 8px; border-radius: 4px; border: 1px solid #ccc;">
    </div>

    <div style="margin-bottom: 10px;">
        <label><b>Wybierz istniejący gatunek:</b></label><br>
        <select id="plantSpeciesSelect" style="width: 100%; padding: 8px; border-radius: 4px; border: 1px solid #ccc;">
            <option value="">Ładowanie gatunków z bazy...</option>
        </select>
    </div>

    <div style="background: #f0f0f0; padding: 15px; border-radius: 8px; margin-top: 20px; max-width: 500px;">
        <h4 style="color: #2e7d32; margin-top: 0;">➕ Dodaj nową kategorię</h4>
        <input type="text" id="newCategoryName" placeholder="Nazwa kategorii" style="width: 70%; padding: 8px; border-radius: 4px; border: 1px solid #ccc;">
        <button onclick="addCategory()" style="background: #2e7d32; color: white; border: none; padding: 8px; border-radius: 4px; cursor: pointer;">Dodaj</button>
    </div>

    <div style="margin-bottom: 15px;">
        <label><b>Podlewanie (co ile dni):</b></label><br>
        <input type="number" id="plantWatering" value="2" style="width: 100%; padding: 8px; border-radius: 4px; border: 1px solid #ccc;">
    </div>

    <button onclick="addPlant()" style="background: #2e7d32; color: white; border: none; padding: 10px; border-radius: 4px; cursor: pointer; width: 100%;">💾 Zapisz</button>
</div>

<h2>📋 Twoje Rośliny</h2>
<div id="list">Ładowanie...</div>

<script>

        // Dodawanie nowej kategorii
    function addCategory() {
        const categoryName = document.getElementById('newCategoryName').value;

        if (!categoryName) return alert("Podaj nazwę kategorii!");

        fetch('/api/PlantCategories', {
            method: 'POST',
            headers: {
                'Authorization': 'Bearer ' + localStorage.getItem('jwtToken'),
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ name: categoryName })
        })
        .then(r => {
            if (r.ok) {
                alert("Kategoria dodana pomyślnie!");
                document.getElementById('newCategoryName').value = ''; // Wyczyść pole
                // Opcjonalnie: odśwież listę kategorii, jeśli masz ją na stronie
            } else if (r.status === 403) {
                alert("Błąd: Nie masz uprawnień administratora.");
            } else {
                alert("Wystąpił błąd przy dodawaniu kategorii.");
            }
        });
    }
    //  Pobierz listę roślin, żeby wyciągnąć z nich unikalne gatunki (Species)
    function loadSpecies() {
        fetch('/api/Plants', { headers: { 'Authorization': 'Bearer ' + localStorage.getItem('jwtToken') } })
        .then(r => r.json())
        .then(data => {
            // Wyciągamy unikalne gatunki (żeby nie było duplikatów)
            const speciesList = [...new Set(data.map(p => p.species).filter(s => s))];
            const select = document.getElementById('plantSpeciesSelect');
            select.innerHTML = speciesList.map(s => `<option value="${s}">${s}</option>`).join('');
        });
    }

    function loadPlants() {
        const token = localStorage.getItem('jwtToken');
        fetch('/api/Plants', { headers: { 'Authorization': 'Bearer ' + token } })
        .then(r => r.json())
        .then(data => {
            document.getElementById('list').innerHTML = data.map(p => `
                <div style="border: 1px solid #eee; padding: 15px; margin: 10px 0; border-radius: 8px;">
                    <h3 style="margin: 0; color: #2e7d32;">🌱 ${p.name}</h3>
                    <p style="margin: 5px 0;">Gatunek: <b>${p.species}</b></p>
                    <button onclick="deletePlant('${p.id}')" style="background: #ff4d4d; color: white; border: none; padding: 5px 10px; border-radius: 4px;">🗑 Usuń</button>
                </div>
            `).join('');
        });
    }

    function addPlant() {
        const data = {
            name: document.getElementById('plantName').value,
            species: document.getElementById('plantSpeciesSelect').value,
            wateringFrequencyDays: parseInt(document.getElementById('plantWatering').value)
        };

        fetch('/api/Plants', {
            method: 'POST',
            headers: { 'Authorization': 'Bearer ' + localStorage.getItem('jwtToken'), 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(r => {
            if (r.ok) {
                document.getElementById('successMessage').style.display = 'block';
                loadPlants();
            }
        });
    }

    function deletePlant(id) {
        fetch(`/api/Plants/${id}`, { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + localStorage.getItem('jwtToken') } })
        .then(() => loadPlants());
    }

    loadSpecies();
    loadPlants();
</script>