<h1>🌿 Szczegóły ogrodu</h1>
<div id="garden">Ładowanie...</div>

<hr>
<h2>➕ Posadź roślinę</h2>
<label><b>Filtruj według gatunku:</b></label>
<br>
<select id="categorySelect" onchange="filterPlants()" style="width: 100%; max-width: 300px; padding: 8px;">
    <option value="all">⭐ Wszystkie</option>
</select>

<div id="plants-list">Ładowanie roślin...</div>

<script>
    const gardenId = window.location.pathname.split('/').pop(); // Pobiera ID z URL
    const token = localStorage.getItem('jwtToken');

    // 1. Ładowanie szczegółów ogrodu
    fetch(`/api/Gardens/${gardenId}`, { headers: { 'Authorization': 'Bearer ' + token } })
    .then(r => r.json())
    .then(g => {
        document.getElementById('garden').innerHTML = `<h3>${g.name}</h3>`;
    });

    // 2. Pobieranie roślin i unikalnych gatunków do filtra
    fetch('/api/Plants', { headers: { 'Authorization': 'Bearer ' + token } })
    .then(r => r.json())
    .then(data => {
        window.allPlants = data; // Zapisujemy globalnie do filtra
        const species = [...new Set(data.map(p => p.species))];
        const select = document.getElementById('categorySelect');
        select.innerHTML = '<option value="all">⭐ Wszystkie</option>' +
                           species.map(s => `<option value="${s}">${s}</option>`).join('');
        renderPlants(data);
    });

    function renderPlants(plants) {
        document.getElementById('plants-list').innerHTML = plants.map(p => `
            <div style="border:1px solid #ddd; padding:10px; margin:5px;">
                ${p.name} (${p.species})
            </div>
        `).join('');
    }

    function filterPlants() {
        const val = document.getElementById('categorySelect').value;
        const filtered = val === 'all' ? window.allPlants : window.allPlants.filter(p => p.species === val);
        renderPlants(filtered);
    }
</script>