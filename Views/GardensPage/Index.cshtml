<h1>🏡 Zarządzanie Ogrodami</h1>

<div id="successMessage" style="display: none; background: #d4edda; color: #155724; padding: 12px; border-radius: 4px; margin-bottom: 20px; border: 1px solid #c3e6cb; font-weight: bold;">
    ✅ Sukces! Nowy ogród został utworzony.
</div>

<div style="background: #e3f2fd; padding: 20px; border-radius: 8px; margin-bottom: 30px; border: 1px solid #bbdefb; max-width: 500px;">
    <h3 style="color: #0d47a1; margin-top: 0;">➕ Utwórz nowy ogród</h3>

    <div style="margin-bottom: 15px;">
        <label><b>Nazwa ogrodu:</b></label><br>
        <input type="text" id="gardenName" placeholder="np. Ogród Warzywny, Balkon" style="width: 100%; padding: 8px; margin-top: 5px; border-radius: 4px; border: 1px solid #ccc;">
    </div>

    <button onclick="createNewGarden()" style="background: #0d47a1; color: white; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer; font-weight: bold; width: 100%;">
        💾 Zapisz ogród
    </button>
</div>

<hr>

<h2>📋 Twoje Ogrody</h2>
<div id="list">Ładowanie listy ogrodów...</div>

<script>
    function loadGardens() {
        const token = localStorage.getItem('jwtToken');
        const container = document.getElementById('list');

        fetch('/api/Gardens', {
            method: 'GET',
            headers: {
                'Authorization': 'Bearer ' + token,
                'Content-Type': 'application/json'
            }
        })
        .then(response => {
            if (response.status === 401) throw new Error("Brak uprawnień. Zaloguj się!");
            if (!response.ok) throw new Error("Błąd serwera: " + response.status);
            return response.json();
        })
        .then(data => {
           
            container.innerHTML = data.map(g => `
                <div style="padding: 15px; border: 1px solid #ddd; margin: 10px 0; border-radius: 8px;">
                    <h3>🌳 ${g.name}</h3>
                    <a href="/GardensPage/Details/${g.id}">Zobacz szczegóły</a>
                </div>
            `).join('');
        })
        .catch(error => {
            container.innerHTML = `<p style="color:red;">❌ ${error.message}</p>`;
            console.error(error);
        });
    }

    function createNewGarden() {
        const token = localStorage.getItem('jwtToken');
        const name = document.getElementById('gardenName').value.trim();

        if (!token) {
            alert("Zaloguj się, aby dodać ogród.");
            window.location.href = '/Account/Login';
            return;
        }

        if (!name) {
            alert("Podaj nazwę ogrodu.");
            return;
        }

        fetch('/api/Gardens', {
            method: 'POST',
            headers: {
                'Authorization': 'Bearer ' + token,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ name })
        })
        .then(response => {
            if (response.status === 401) throw new Error("Brak uprawnień. Zaloguj się ponownie.");
            if (!response.ok) throw new Error("Nie udało się utworzyć ogrodu.");
            return response.json();
        })
        .then(() => {
            document.getElementById('gardenName').value = '';
            document.getElementById('successMessage').style.display = 'block';
            loadGardens();
        })
        .catch(error => {
            alert(error.message);
            console.error(error);
        });
    }

    loadGardens();
</script>
